# Copy this file to .env.local and fill in real values.
# Anything left unset must degrade gracefully in the UI (element hidden or stub used).

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://visaexpeditor.com"

# ---------------------------------------------------------------------------
# Clerk (owner supplies production keys)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# ---------------------------------------------------------------------------
# Database (owner supplies; local stub until then)
# ---------------------------------------------------------------------------
DATABASE_URL=""

# ---------------------------------------------------------------------------
# Email (Resend; owner supplies verified sender domain)
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
TEAM_EMAIL=""

# ---------------------------------------------------------------------------
# Abuse protection
# ---------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ---------------------------------------------------------------------------
# Contact / trust details (UI hides anything unset)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_WHATSAPP_NUMBER=""
NEXT_PUBLIC_PHONE_NUMBER=""
NEXT_PUBLIC_SUPPORT_EMAIL=""
NEXT_PUBLIC_ENTITY_NAME=""
NEXT_PUBLIC_ENTITY_ADDRESS=""

# ---------------------------------------------------------------------------
# Operations
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_ANALYTICS_ENABLED="false"
LEGAL_DRAFT_BANNER="true"
ADMIN_EMAILS=""
