# Copy this file to .env.local and fill in real values.
# Anything left unset must degrade gracefully in the UI (element hidden or stub used).

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://visa-expeditor.vercel.app"

# ---------------------------------------------------------------------------
# Neon Auth (better-auth hosted by Neon)
# Base URL is shown in the Neon Console under Auth → Configuration.
# Generate the cookie secret with: openssl rand -base64 32
# ---------------------------------------------------------------------------
NEON_AUTH_BASE_URL=""
NEON_AUTH_COOKIE_SECRET=""

# ---------------------------------------------------------------------------
# Database (owner supplies; local stub until then)
# ---------------------------------------------------------------------------
DATABASE_URL=""
DATA_API=""
JWKS_URL=""

# ---------------------------------------------------------------------------
# Email (Resend; owner supplies verified sender domain)
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
TEAM_EMAIL=""
RESEND_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# Abuse protection
# ---------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ---------------------------------------------------------------------------
# Contact / trust details (UI hides anything unset)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_WHATSAPP_NUMBER=""
NEXT_PUBLIC_PHONE_NUMBER=""
NEXT_PUBLIC_SUPPORT_EMAIL=""
NEXT_PUBLIC_ENTITY_NAME=""
NEXT_PUBLIC_ENTITY_ADDRESS=""

# ---------------------------------------------------------------------------
# Operations
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_ANALYTICS_ENABLED="false"
# Legal pages show a draft banner unless this is explicitly "false".
LEGAL_DRAFT_BANNER="true"
ADMIN_EMAILS=""
